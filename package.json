{
    "name": "api-boilerplate",
    "version": "0.0.1",
    "description": "NestJS + Prisma API boilerplate with auth, RBAC, uploads, notifications, queues, Docker and CI/CD",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "prepare": "husky",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/src/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "jest",
        "test:ci": "jest --ci --passWithNoTests --coverage",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "test:e2e:ci": "jest --config ./test/jest-e2e.json --ci --runInBand --forceExit --passWithNoTests",
        "db:generate": "prisma generate",
        "db:migrate:dev": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:seed": "prisma db seed"
    },
    "dependencies": {
        "@bull-board/api": "^7.0.0",
        "@bull-board/express": "^7.0.0",
        "@nestjs/bullmq": "^11.0.4",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.3",
        "@nestjs/core": "^11.0.1",
        "@nestjs/event-emitter": "^3.1.0",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/swagger": "^11.4.2",
        "@nestjs/throttler": "^6.5.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "argon2": "^0.44.0",
        "axios": "^1.16.0",
        "bullmq": "^5.76.7",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "dotenv": "^17.4.2",
        "express-basic-auth": "^1.2.1",
        "file-type": "^22.0.1",
        "firebase-admin": "^13.9.0",
        "handlebars": "^4.7.8",
        "helmet": "^8.1.0",
        "ioredis": "^5.10.1",
        "joi": "^18.2.1",
        "nanoid": "^5.1.11",
        "nestjs-pino": "^4.6.1",
        "nodemailer": "^8.0.7",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "pg": "^8.20.0",
        "pino-http": "^11.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.0.0",
        "@commitlint/config-conventional": "^21.0.0",
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@types/express": "^5.0.0",
        "@types/ioredis": "^4.28.10",
        "@types/jest": "^30.0.0",
        "@types/multer": "^2.1.0",
        "@types/node": "^24.0.0",
        "@types/nodemailer": "^8.0.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.38",
        "@types/supertest": "^7.0.0",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.0.0",
        "husky": "^9.1.7",
        "jest": "^30.0.0",
        "lint-staged": "^17.0.4",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.4.2",
        "prisma": "^7.8.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.21.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": [
                "ts-jest",
                {
                    "tsconfig": {
                        "module": "commonjs",
                        "moduleResolution": "node10",
                        "allowJs": true,
                        "esModuleInterop": true,
                        "allowSyntheticDefaultImports": true,
                        "resolvePackageJsonExports": false,
                        "declaration": false,
                        "incremental": false
                    }
                }
            ]
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^(\\.{1,2}/.*)\\.js$": "$1",
            "^@generated/(.*)$": "<rootDir>/../prisma/generated/$1",
            "^@common/(.*)$": "<rootDir>/common/$1",
            "^@config$": "<rootDir>/config",
            "^@infra/(.*)$": "<rootDir>/infrastructure/$1",
            "^@modules/(.*)$": "<rootDir>/modules/$1",
            "^@shared/(.*)$": "<rootDir>/shared/$1",
            "^@tasks$": "<rootDir>/tasks",
            "^@/(.*)$": "<rootDir>/$1"
        },
        "transformIgnorePatterns": [
            "node_modules/(?!(?:@borewit/text-codec|@epic-web/invariant|@hapi/tlds|@standard-schema/spec|@tokenizer/inflate|file-type|libphonenumber-js|msgpackr|nanoid|proxy-from-env|strtok3|token-types|uint8array-extras)/)"
        ]
    }
}
