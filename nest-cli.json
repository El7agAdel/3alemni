{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "deleteOutDir": true,
        "assets": [
            {
                "include": "shared/messaging/email/views/**/*.hbs",
                "outDir": "dist/src",
                "watchAssets": true
            }
        ]
    }
}
