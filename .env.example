# ==================================================
# Application
# ==================================================

# APP_NAME is the single source of the product name. Emails, push notifications,
# Swagger, the queue dashboard, generated QR codes, the JWT issuer, and the cache
# key prefix all read it - rename the app here and nowhere else.
APP_NAME=App

# Identifier form of APP_NAME, used where a display name will not do: Docker
# project/container/volume names, cache prefixes, the JWT issuer, WhatsApp
# template names. Defaults to a slugified APP_NAME; set it explicitly only when
# the two must differ. Lowercase words separated by single dashes.
APP_SLUG=

NODE_ENV=development

# Host ports use the conventional defaults. Change APP_PORT, DATABASE_PORT, and
# REDIS_PORT if something is already listening on them - the Docker compose files
# read the same variables, so both sides stay in sync.
APP_PORT=3000
APP_URL=http://localhost
APP_WEB_URL=http://localhost:3000

#==================================================
# API
#==================================================

# Swagger
SWAGGER_ENABLED=true
SWAGGER_AUTH_ENABLED=true
SWAGGER_USERNAME=[SWAGGER_USERNAME]
SWAGGER_PASSWORD=[SWAGGER_PASSWORD]

#==================================================
# Security
#==================================================

# CORS
CORS_ENABLED=true
CORS_ORIGINS=*

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Request handling
REQUEST_BODY_LIMIT=1mb
REQUEST_TIMEOUT=30000

#==================================================
# Database
#==================================================

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=app_dev
DATABASE_USERNAME=[DATABASE_USERNAME]
DATABASE_PASSWORD=[DATABASE_PASSWORD]
DATABASE_URL=postgresql://[DATABASE_USERNAME]:[DATABASE_PASSWORD]@localhost:5432/app_dev

#==================================================
# Redis
#==================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=[REDIS_PASSWORD]

#==================================================
# Logger
#==================================================

LOG_LEVEL=debug
LOG_HTTP_ENABLED=true
LOG_SLOW_REQUEST_THRESHOLD=0

#==================================================
# Cache
#==================================================

# Cache Redis
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6379
CACHE_REDIS_PASSWORD=[REDIS_PASSWORD]

#==================================================
# Queue
#==================================================

# Queue Redis
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=[REDIS_PASSWORD]

# Bull Board (queue dashboard, optional and access-controlled)
BULL_BOARD_ENABLED=true
BULL_BOARD_AUTH_ENABLED=true
BULL_BOARD_USERNAME=[BULL_BOARD_USERNAME]
BULL_BOARD_PASSWORD=[BULL_BOARD_PASSWORD]

#==================================================
# Communication
#==================================================

# When true, no real provider is contacted - all sends are logged instead
COMMUNICATION_DEV_MODE=true

# Mailer (required - email is the primary channel)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=[SMTP_USER]
SMTP_PASSWORD=[SMTP_PASSWORD]
SMTP_SECURE=false
SMTP_FROM_ADDRESS=[SMTP_FROM_ADDRESS]
SMTP_FROM_NAME=App

# WhatsApp (optional - required only when WHATSAPP_ENABLED=true)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Firebase Cloud Messaging (optional - required only when FCM_ENABLED=true)
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

#==================================================
# Storage
#==================================================

# Local storage is the only provider shipped with the boilerplate
STORAGE_PROVIDER=local
STORAGE_BASE_URL=http://localhost:3000/uploads

#==================================================
# Auth
#==================================================

# JWT (ES256 keypair, PEM-encoded; generate with: openssl ecparam -genkey -name prime256v1 -noout)
JWT_PRIVATE_KEY=[JWT_PRIVATE_KEY_PEM]
JWT_PUBLIC_KEY=[JWT_PUBLIC_KEY_PEM]
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# OTP
OTP_EXPIRY_SECONDS=600
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_LIMIT_WINDOW_SECONDS=900
OTP_MAX_FAILED_ATTEMPTS=5
OTP_LOCKOUT_DURATION=900

# Login protection
LOGIN_MAX_ATTEMPTS=5

# Transactional tokens (multi-step registration/password-reset flows)
TRANSACTIONAL_TOKEN_EXPIRY_SECONDS=600

# Account deletion grace period
ACCOUNT_DELETION_GRACE_PERIOD_DAYS=30

#==================================================
# Bootstrap admin (optional, safe, idempotent)
# Set these to create the initial System-role administrator on first seed run.
# Leave blank to skip - no default/hardcoded admin account is ever created.
#==================================================

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

#==================================================
# Deployment (read by docker compose, not by the app)
#==================================================

# Host directory mounted at /app/uploads in staging and production.
# Defaults to <compose project dir>/../uploads when unset.
UPLOADS_PATH=

# Image the production stack runs when docker/docker-compose.runtime.yml is
# included. CI overrides it with an immutable ghcr.io/...:sha-<short-sha> tag.
APP_IMAGE=app-api:prod
