# Throwaway environment for CI. Loaded by every job in .github/workflows/ci.yml.
#
# Nothing here is a real credential. The database and Redis are ephemeral
# service containers that exist only for the length of one job, and the JWT
# keypair is generated fresh per run by the workflow (not stored here).
#
# Why this file exists: src/config/configuration.ts reads every variable through
# env(), which THROWS on undefined, and src/config/env.schema.ts validates the
# result with Joi. A variable is required even when the feature it belongs to is
# switched off - SWAGGER_USERNAME is read whether or not SWAGGER_AUTH_ENABLED is
# true. Anything that boots ConfigModule, including a unit test, needs all of it.
#
# Add a new env() call to configuration.ts? Add the variable here too.
#
# Format: KEY=value, one per line, no quotes (the whole line after "=" is the
# value). Comments and blank lines are stripped before this is appended to
# $GITHUB_ENV. To reproduce a CI run locally, see the note at the bottom.

NODE_ENV=test
APP_NAME=App CI
APP_SLUG=app-ci
APP_PORT=3000
APP_URL=http://localhost
APP_WEB_URL=http://localhost:3000

# Swagger is off, but its credentials are still read unconditionally.
SWAGGER_ENABLED=false
SWAGGER_AUTH_ENABLED=false
SWAGGER_USERNAME=ci
SWAGGER_PASSWORD=ci

CORS_ENABLED=true
CORS_ORIGINS=*
THROTTLE_TTL=60
THROTTLE_LIMIT=100
REQUEST_BODY_LIMIT=1mb
REQUEST_TIMEOUT=30000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=app
DATABASE_PASSWORD=app
DATABASE_NAME=app_test
DATABASE_URL=postgresql://app:app@localhost:5432/app_test

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6379
CACHE_REDIS_PASSWORD=
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=

LOG_LEVEL=warn
LOG_HTTP_ENABLED=false
LOG_SLOW_REQUEST_THRESHOLD=0

# Bull Board is off, but its credentials are still read unconditionally.
BULL_BOARD_ENABLED=false
BULL_BOARD_AUTH_ENABLED=false
BULL_BOARD_USERNAME=ci
BULL_BOARD_PASSWORD=ci

# No real provider is contacted in this mode - sends are logged instead.
COMMUNICATION_DEV_MODE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ci
SMTP_PASSWORD=ci
SMTP_FROM_ADDRESS=ci@example.com
SMTP_FROM_NAME=App CI

# Optional providers stay disabled; their variables are still read.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

STORAGE_PROVIDER=local
STORAGE_BASE_URL=http://localhost:3000/uploads

# JWT_PRIVATE_KEY and JWT_PUBLIC_KEY are generated per run by the workflow.
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

OTP_EXPIRY_SECONDS=600
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_LIMIT_WINDOW_SECONDS=900
OTP_MAX_FAILED_ATTEMPTS=5
OTP_LOCKOUT_DURATION=900
LOGIN_MAX_ATTEMPTS=5
TRANSACTIONAL_TOKEN_EXPIRY_SECONDS=600
ACCOUNT_DELETION_GRACE_PERIOD_DAYS=30

# Left blank so the seed never creates an admin account in CI.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=

# Reproduce a CI run locally (bash), from the repo root:
#
#   mv .env .env.hold          # CI has no .env file; this is what makes it faithful
#
#   while IFS='=' read -r k v; do export "$k=$v"; done \
#     < <(grep -vE '^#|^$' test/ci.env)
#
#   openssl ecparam -genkey -name prime256v1 -noout -out /tmp/jwt.key
#   openssl ec -in /tmp/jwt.key -pubout -out /tmp/jwt.pub
#   export JWT_PRIVATE_KEY="$(cat /tmp/jwt.key)"
#   export JWT_PUBLIC_KEY="$(cat /tmp/jwt.pub)"
#
#   npm run test:ci
#   mv .env.hold .env
#
# Use the read loop, not `set -a; . file`. Values here are deliberately
# unquoted because $GITHUB_ENV takes the whole line after "=" verbatim, but
# `source` would split SMTP_FROM_NAME=App CI into an assignment plus an
# attempt to run "CI". The loop handles spaces correctly.
