{{#if recipientName}}
  <p style="margin: 0 0 16px; color: #1a1a1a;">Hi {{recipientName}},</p>
{{else}}
  <p style="margin: 0 0 16px; color: #1a1a1a;">Hi,</p>
{{/if}}

<h2
  style="margin: 0 0 8px; font-size: 20px; font-weight: 600; color: #1a1a1a;"
>Security Alert</h2>

<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  width="100%"
>
  <tr>
    <td
      style="padding: 16px; background-color: #fee2e2; border-left: 4px solid #ef4444; border-radius: 4px;"
    >
      <p style="margin: 0; color: #991b1b; font-size: 14px;">{{event}}</p>
    </td>
  </tr>
</table>

<p style="margin: 16px 0 4px; color: #4b5563;">Occurred at:
  <strong>{{occurredAt}}</strong></p>
{{#if ipAddress}}
  <p style="margin: 0 0 16px; color: #4b5563;">IP address:
    <strong>{{ipAddress}}</strong></p>
{{/if}}

<p style="margin: 24px 0 0; font-size: 13px; color: #9ca3af;">
  If this wasn't you, change your password immediately and review your active
  sessions.
</p>