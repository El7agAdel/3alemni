{{#if recipientName}}
  <p style="margin: 0 0 16px; color: #1a1a1a;">Hi {{recipientName}},</p>
{{else}}
  <p style="margin: 0 0 16px; color: #1a1a1a;">Hi,</p>
{{/if}}

<h2
  style="margin: 0 0 8px; font-size: 20px; font-weight: 600; color: #1a1a1a;"
>{{purposeHeading}}</h2>

<p style="margin: 0 0 24px; color: #4b5563;">{{purposeDescription}}</p>

<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  width="100%"
>
  <tr>
    <td
      align="center"
      style="padding: 24px; background-color: #f3f4f6; border-radius: 8px;"
    >
      <span
        style="font-size: 36px; font-weight: 700; letter-spacing: 8px; color: #1a1a1a; font-family: 'Courier New', Courier, monospace;"
      >{{otp}}</span>
    </td>
  </tr>
</table>

<p style="margin: 24px 0; color: #4b5563;">This code expires in
  <strong>{{expiryMinutes}} minutes</strong>.</p>

<p style="margin: 0; font-size: 13px; color: #9ca3af;">{{purposeIgnoreText}}</p>